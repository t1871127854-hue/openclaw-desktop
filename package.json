{
  "name": "openclaw-launcher",
  "private": true,
  "version": "0.2.0",
  "description": "OpenClaw Launcher desktop shell for Windows runtime setup, repair, configuration, and lifecycle management.",
  "author": "OpenAI Codex",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "npm run build && electron-builder --publish never",
    "pack:dir": "npm run build && electron-builder --dir --publish never",
    "dist:win": "npm run build && electron-builder --win portable nsis --x64 --publish never",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');['dist','dist-electron','release'].forEach((p)=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck"
  },
  "build": {
    "appId": "com.openclaw.launcher",
    "productName": "OpenClaw Launcher",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
